# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/quocbank?schema=public"

# Auth (server-only)
JWT_SECRET="change-me-long-random"

# Email Alerts (server-only)
RESEND_API_KEY=""
SECURITY_ALERT_EMAIL_FROM="QuocBank Security <security@yourdomain.com>"
SECURITY_ALERT_EMAIL_TO="security-team@yourdomain.com"

# Admin control panel access (comma-separated usernames)
ADMIN_USERNAMES="admin"

# Rate/limits
CARD_ISSUE_DAILY_LIMIT="3"
TRANSFER_FEE_RATE="0.005"
WITHDRAW_FEE_RATE="0.005"
TRANSFER_ALERT_THRESHOLD="100000000"

# CSP (Edge middleware)
# Defaults are safe-ish & compatible; tighten per deployment.
CSP_CONNECT_SRC="'self'"
CSP_IMG_SRC="'self' data: blob:"
CSP_FRAME_SRC="'none'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'"
